<?xml version="1.0" encoding="utf-8"?>
<!-- MergeRootFrame suppressed: a real root view keeps this layout usable
     as-is by setContentView and the WebView-recreate path (view.parent). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- In-app update prompt (slice 21-SHELL). A quiet strip along the bottom
         of the page, NOT a modal: an update must never stand between a
         technician and the record they are filling in. Declared before the
         offline card so the card, which is full-screen and opaque, always
         covers it. Hidden unless there is genuinely something to say. -->
    <LinearLayout
        android:id="@+id/updateBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ink"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="BamForm 1.2.0 is available" />

        <TextView
            android:id="@+id/updateDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/ink_soft"
            android:textSize="13sp"
            tools:text="You are running 1.0.0." />

        <ProgressBar
            android:id="@+id/updateProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:max="100"
            android:visibility="gone" />

        <!-- ButtonStyle suppressed: the borderless button-bar style lint wants
             belongs to dialogs. This is an in-page strip whose buttons must
             read as the same filled/tinted controls as the offline card and
             the PWA's own design tokens — a borderless pair here would look
             like page content rather than app chrome. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal"
            tools:ignore="ButtonStyle">

            <Button
                android:id="@+id/updateSecondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/panel_sunken"
                android:textAllCaps="false"
                android:textColor="@color/accent"
                tools:text="Not now" />

            <Button
                android:id="@+id/updatePrimary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:backgroundTint="@color/accent"
                android:textAllCaps="false"
                android:textColor="@color/accent_ink"
                tools:text="Download update" />
        </LinearLayout>
    </LinearLayout>

    <!-- Native fallback, ERROR PATH ONLY: the sign-in page (which hosts the
         normal server control) is served by the server itself, so when the
         server is unreachable this card is the only way to retry or repoint.
         Never shown while the server is healthy. -->
    <ScrollView
        android:id="@+id/offlineCard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/canvas"
        android:fillViewport="true"
        android:visibility="gone">

        <!-- The wrapper exists to centre the card vertically; lint cannot
             see layout_gravity="center" from the child's side. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="480dp"
            android:padding="24dp"
            tools:ignore="UselessParent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/panel_bg"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/offline_title"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/offlineDetail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/retryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/accent"
                    android:text="@string/offline_retry"
                    android:textAllCaps="false"
                    android:textColor="@color/accent_ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:labelFor="@id/serverField"
                    android:letterSpacing="0.06"
                    android:text="@string/server_label"
                    android:textAllCaps="true"
                    android:textColor="@color/ink_soft"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/serverField"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/input_bg"
                    android:imeOptions="actionGo"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textColor="@color/ink"
                    android:textColorHint="@color/ink_faint"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/httpWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/warn_bg"
                    android:padding="12dp"
                    android:text="@string/server_http_warning"
                    android:textColor="@color/ink"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/connectButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/panel_sunken"
                    android:text="@string/server_connect"
                    android:textAllCaps="false"
                    android:textColor="@color/accent" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </ScrollView>
</FrameLayout>
