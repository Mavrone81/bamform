<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Photo capture for form attachments (input type="file" capture). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- In-app update (slice 21-SHELL). This permission grants the right to
         ASK the platform installer to install an APK — the user still
         confirms in Android's own installer UI, and the system additionally
         requires "install unknown apps" to be enabled for this app. There is
         no silent-install capability here and none is wanted. The shell only
         ever asks for a file it has already checked against the published
         SHA-256 and proved to be signed by the same key as itself; see
         UpdateService. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Backups/transfers disabled entirely: the shell holds no data worth
         migrating (one URL), and the WebView's cookie jar should never
         travel to another device via cloud backup. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BamForm"
        tools:targetApi="s">

        <!-- Boots straight into the WebView at the configured origin.
             configChanges: keep the WebView (and the PWA's in-memory state)
             alive across rotation / fold / density changes. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Scratch URIs handed to the camera app for photo capture. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
