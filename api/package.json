{
  "name": "@bamform/api",
  "version": "0.1.0",
  "private": true,
  "description": "BamForm API — NestJS 11 on Node 22 (PR-015).",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "bootstrap:admin": "node dist/bootstrap-admin.js",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=4096\" jest --config jest.integration.config.js --runInBand",
    "test:unit": "jest --config jest.unit.config.js",
    "test:contract": "jest --config jest.contract.config.js contract.spec.ts",
    "test:route-coverage": "jest --config jest.contract.config.js \"route-(coverage|roles)\\.spec\\.ts\"",
    "test:scope-coverage": "jest --config jest.contract.config.js scope-coverage.spec.ts",
    "test:security": "jest --config jest.security.config.js --runInBand",
    "test:log-redaction": "jest --config jest.log-redaction.config.js"
  },
  "dependencies": {
    "@bamform/shared": "*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@prisma/client": "6.19.3",
    "archiver": "^7.0.1",
    "argon2": "0.45.1",
    "bullmq": "5.81.2",
    "cookie-parser": "1.4.7",
    "ioredis": "5.11.1",
    "jose": "5.10.0",
    "minio": "8.0.7",
    "nodemailer": "9.0.3",
    "puppeteer": "^21.11.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.1.28",
    "@types/archiver": "^6.0.4",
    "@types/cookie-parser": "1.4.10",
    "@types/jest": "30.0.0",
    "@types/multer": "1.4.13",
    "@types/node": "22.20.1",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "adm-zip": "^0.6.0",
    "jest": "30.4.2",
    "js-yaml": "5.2.2",
    "pdf-parse": "^2.4.5",
    "pg": "8.22.0",
    "prisma": "6.19.3",
    "source-map-support": "0.5.21",
    "supertest": "7.1.4",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
