{
  // rootDir is the REPO root (slice 13-TL): the template-load integration
  // specs (test/integration/template-load/*) import the loader sources from
  // scripts/template-load/src/, which TS would otherwise reject with TS6059
  // ("not under rootDir") — the same widening tsconfig.jest.json already
  // applies for shared/src. Emit layout is unaffected: `nest build` uses
  // tsconfig.build.json, which overrides rootDir back to "src".
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "dist",
    "rootDir": "..",
    "baseUrl": "./",
    "incremental": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
