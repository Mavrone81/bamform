{
  // Pre-existing bug fixed here (slice 5): tsconfig.json sets rootDir "."
  // (needed so ts-jest can typecheck test/**/*.ts against the same base
  // config) and this file only narrowed `exclude`, never `rootDir` — so
  // `nest build` emitted dist/src/main.js while docker-compose.yml's
  // `bamform-api`/`bamform-worker` CMD/healthcheck (and this Dockerfile)
  // all reference `dist/main.js` / `dist/worker.js` / `dist/healthcheck.js`
  // / `dist/worker-healthcheck.js` with no `src/` prefix. Since only
  // `src/**/*.ts` is compiled here (test/ is excluded), narrowing rootDir to
  // "src" flattens the output to match what the runtime actually invokes —
  // required for `dist/worker.js` (this slice's deliverable) to exist at
  // all, and incidentally fixes the same latent mismatch for `dist/main.js`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
