{
  "name": "bamform",
  "private": true,
  "description": "BamForm — Preventive Maintenance Record and Approval System",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "//hooks": "core.hooksPath points git at scripts/git-hooks (tracked, reviewable) instead of the untracked .git/hooks. `prepare` runs on npm install/ci; it is deliberately total — inside the Docker build stages there is no git binary and no .git directory, and an install must not fail because of a developer convenience.",
    "prepare": "git config core.hooksPath scripts/git-hooks 2>/dev/null || true",
    "hooks:install": "git config core.hooksPath scripts/git-hooks",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "npm run prisma:generate --workspace=api",
    "pretypecheck": "npm run prisma:generate --workspace=api",
    "typecheck": "npm run typecheck --workspace=shared && npm run build --workspace=shared && npm run typecheck --workspace=api && npm run typecheck --workspace=web",
    "build": "npm run build --workspace=shared && npm run build --workspace=api && npm run build --workspace=web",
    "pretest:integration": "npm run prisma:generate --workspace=api && bash scripts/dev/generate-dev-secrets.sh",
    "test:integration": "npm run test:integration --workspace=api --",
    "test:integration:local": "bash scripts/dev/run-integration-tests.sh",
    "pretest:unit": "npm run prisma:generate --workspace=api && bash scripts/dev/generate-dev-secrets.sh",
    "test:unit": "npm run test:unit --workspace=api --",
    "pretest:contract": "npm run prisma:generate --workspace=api",
    "test:contract": "npm run test:contract --workspace=api --",
    "pretest:route-coverage": "npm run prisma:generate --workspace=api",
    "test:route-coverage": "npm run test:route-coverage --workspace=api --",
    "pretest:scope-coverage": "npm run prisma:generate --workspace=api",
    "test:scope-coverage": "npm run test:scope-coverage --workspace=api --",
    "pretest:security": "npm run prisma:generate --workspace=api && bash scripts/dev/generate-dev-secrets.sh",
    "test:security": "npm run test:security --workspace=api --",
    "test:log-redaction": "npm run test:log-redaction --workspace=api --",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:unit:web": "npm run test:unit --workspace=web -- --coverage",
    "test:offline": "npm run test:offline --workspace=web",
    "test:e2e": "npm run test:e2e --workspace=web",
    "test:a11y": "npm run test:a11y --workspace=web",
    "gen:api-types": "npm run gen:api-types --workspace=web",
    "import:masterlist": "ts-node -P scripts/template-load/tsconfig.json scripts/template-load/src/masterlist/cli.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stoplight/spectral-cli": "^6.16.2",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "argon2@0.45.1": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "tar-fs": "^3.1.3",
    "ws": "^8.18.3"
  }
}
