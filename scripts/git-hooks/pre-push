#!/usr/bin/env bash
# BamForm pre-push hook — the three gates that keep getting missed.
#
# WHY THIS EXISTS. Jobs 3-11 in .github/workflows/ci.yml all `needs` job 1.
# When job 1 goes red GitHub **skips** them rather than failing them, and a
# pipeline of skipped jobs reads as safe at a glance. On 2026-07-31 a single
# prettier error from 47d5c86 had been doing exactly that for four days,
# hiding a stale-types failure and an undocumented migration, and leaving two
# merges to main completely unvalidated.
#
# The three checks below are the ones implementers actually miss, because
# `lint` + `tsc` pass and that feels like enough:
#
#   1. prettier            — job 1, the one that skips everything downstream
#   2. generated API types — job 5, whenever api/openapi.yaml grows
#   3. migration reversal  — job 11's M-04 gate, on every new migration
#
# Each runs the SAME command CI runs, not a reimplementation of it, so this
# hook cannot drift from the pipeline it is protecting.
#
# Checks 2 and 3 only run when the push actually contains the files they
# cover. Check 1 always runs — it is ~4s and it is the one that cascades.
#
# Bypass with `git push --no-verify`, or BAMFORM_SKIP_PREPUSH=1.

set -euo pipefail

if [ "${BAMFORM_SKIP_PREPUSH:-0}" = "1" ]; then
  echo "pre-push: skipped (BAMFORM_SKIP_PREPUSH=1)" >&2
  exit 0
fi

cd "$(git rev-parse --show-toplevel)"

# --- work out what is actually being pushed -------------------------------
# stdin gives one line per ref: <local ref> <local sha> <remote ref> <remote sha>
# An all-zero sha means "does not exist": as the local sha it is a deletion,
# as the remote sha it is a branch the remote has not seen before.
is_zero_sha() { case "${1:-}" in *[!0]*) return 1 ;; *) return 0 ;; esac; }

changed=""
saw_ref=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "${local_sha:-}" ] || continue
  saw_ref=1
  if is_zero_sha "$local_sha"; then continue; fi

  if is_zero_sha "${remote_sha:-}"; then
    # New branch on the remote: diff against where it left main, so a long
    # feature branch does not re-check every file main already validated.
    base="$(git merge-base origin/main "$local_sha" 2>/dev/null || true)"
  else
    base="$remote_sha"
  fi

  if [ -n "$base" ]; then
    changed+=$'\n'"$(git diff --name-only --diff-filter=d "$base" "$local_sha" || true)"
  else
    # No common ancestor (unrelated history) — treat everything as changed.
    changed+=$'\n'"$(git ls-tree -r --name-only "$local_sha" || true)"
  fi
done

changed="$(printf '%s\n' "$changed" | grep -v '^$' || true)"

run_types=0
run_migrations=0
if [ "$saw_ref" -eq 0 ]; then
  # Invoked without ref info — be conservative and run everything.
  run_types=1
  run_migrations=1
else
  # `cmd && var=1` would abort the whole hook under `set -e` on a miss.
  if printf '%s\n' "$changed" | grep -q '^api/openapi\.yaml$'; then run_types=1; fi
  if printf '%s\n' "$changed" | grep -q '^api/prisma/migrations/'; then run_migrations=1; fi
fi

fail=0

# --- 1. prettier (job 1 — the one that skips jobs 3-11) -------------------
if [ -d node_modules ]; then
  echo "pre-push: [1] prettier"
  if ! npm run --silent format:check; then
    echo "pre-push: FAILED format:check — run 'npm run format' and commit the result." >&2
    echo "          This is the check whose failure makes CI SKIP jobs 3-11." >&2
    fail=1
  fi
else
  echo "pre-push: WARNING — node_modules missing, skipping prettier and type checks." >&2
  echo "          Run 'npm ci' to get the full gate. CI will still catch these." >&2
  run_types=0
fi

# --- 2. generated API types (job 5) ---------------------------------------
if [ "$run_types" -eq 1 ]; then
  echo "pre-push: [2] generated API types (api/openapi.yaml changed)"
  npm run --silent gen:api-types
  if ! git diff --quiet -- web/src/api/generated; then
    echo "pre-push: FAILED — web/src/api/generated was stale." >&2
    echo "          It has just been REGENERATED in your working tree." >&2
    echo "          Review it, commit it, then push again." >&2
    fail=1
  fi
fi

# --- 3. migration reversal notes (job 11, M-04) ---------------------------
if [ "$run_migrations" -eq 1 ]; then
  echo "pre-push: [3] migration reversal notes (migrations changed)"
  bash scripts/ci/assert-migration-reversal-documented.sh || fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "" >&2
  echo "pre-push: refusing to push — fix the above, or bypass with 'git push --no-verify'." >&2
  exit 1
fi

echo "pre-push: OK"
