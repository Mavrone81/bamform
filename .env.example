# BamForm configuration — BAMFORM-ENV-001 §4
#
# Copy to .env on the SERVER only. Never commit .env.
# NOT a plain `cp` — the four connection strings below carry `__…__` placeholders
# that must be substituted first. DEPLOYMENT_RUNBOOK.md §3.2.1 is the procedure.
#
# KEY MATERIAL IS NOT HERE. The KEK, the wrapped DEK, the blind-index key, both
# Ed25519 signing keys and the MinIO SSE key are supplied as Docker secrets,
# file-mounted from ./secrets/ (PR-SEC-15/16) and read by `SecretFileLoader`.
#
# ⚠️ THE FOUR CONNECTION STRINGS BELOW ARE THE EXCEPTION. Nothing in the
# application reads a password out of ./secrets/ and injects it into a URL —
# `PrismaService` and `RedisModule` pass `DATABASE_URL` / `REDIS_URL` to their
# drivers verbatim (see `api/src/redis/redis.module.ts`'s comment). The
# credential must therefore be written INTO the URL on the server, by hand,
# matching the secret file the server container reads. See DEPLOYMENT_RUNBOOK.md
# §3.2 — a first install fails at `bamform-migrate` with `P1000: Authentication
# failed` if this is skipped. That makes the .env on a real host secret-bearing:
# `chmod 600`, and it is backed up with the secrets, not with the config.
#
# CI asserts that every key in the application's config schema appears here
# (PR-ENV-26). That is what stops this file going stale.

# ---------------------------------------------------------------- core
NODE_ENV=production
APP_ENV=production                      # local | ci | staging | production
APP_BASE_URL=https://form.bevorasg.com
LOG_LEVEL=info
TZ_DISPLAY=Asia/Kuala_Lumpur            # storage is always UTC (DBD DP-8)
TRUST_PROXY_HOPS=1                      # MUST match the proxy chain or the audit trail records the wrong client IP
# Tags the built images AND becomes VITE_APP_VERSION (docker-compose.yml).
# `local` is correct for a developer machine ONLY. On the droplet,
# scripts/server/auto-deploy-bamform.sh OVERRIDES this with the short SHA of
# the commit it just checked out, and REFUSES to deploy if it cannot.
# Leaving it constant in production is what made every deploy's sw.js
# byte-identical, so no client could ever self-update (slice 22, review S-1);
# scripts/ci/assert-sw-changes-per-build.sh now fails the build if the
# service worker stops varying, whatever this is set to.
IMAGE_TAG=local

# ------------------------------------------------- host ports (PROVISIONAL)
# Assigned only after Phase 0 recon proves no collision (OI-07).
# Both bind to 127.0.0.1 only. Postgres/Redis/MinIO publish NOTHING.
WEB_PORT=
API_PORT=

# ------------------------------------------------------------ database
# Replace each __…__ placeholder with the contents of the named secret file —
# no newline, and percent-encode anything outside [A-Za-z0-9._~-] (which is why
# RUNBOOK §3.1 generates these four with `openssl rand -hex 32`: a base64
# password containing `/` does not parse as a URL at all).
#   bamform_app      ← secrets/app_password       (created by db/init/01-roles.sh)
#   bamform_migrate  ← secrets/postgres_password  (POSTGRES_PASSWORD_FILE)
#   bamform_readonly ← secrets/readonly_password  (created by db/init/01-roles.sh)
DATABASE_URL=postgresql://bamform_app:__APP_PASSWORD__@bamform-postgres:5432/bamform?schema=public
DATABASE_MIGRATE_URL=postgresql://bamform_migrate:__POSTGRES_PASSWORD__@bamform-postgres:5432/bamform?schema=public
DATABASE_READONLY_URL=postgresql://bamform_readonly:__READONLY_PASSWORD__@bamform-postgres:5432/bamform?schema=public
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --------------------------------------------------------------- redis
# `redis-server --requirepass` (docker-compose.yml) means the default user has
# a password and no username — hence the empty userinfo user, `redis://:pw@`.
# Same rule as above: paste in secrets/redis_password, percent-encoded.
REDIS_URL=redis://:__REDIS_PASSWORD__@bamform-redis:6379
QUEUE_PREFIX=bull

# ------------------------------------------------------- object storage
MINIO_ENDPOINT=bamform-minio:9000
MINIO_ROOT_USER=bamform
MINIO_BUCKET=bamform-attachments
ATTACHMENT_MAX_BYTES=10485760           # 10 MB
ATTACHMENT_MAX_PER_JOB=30
ATTACHMENT_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ------------------------------------------------------------- crypto
# Key MATERIAL lives in ./secrets/. Only non-secret parameters here.
DEK_VERSION=1
JWT_KID_CURRENT=bf-2026-07
JWT_ISSUER=https://form.bevorasg.com
JWT_AUDIENCE=bamform-api
ACCESS_TOKEN_TTL_SECONDS=900            # 15 min
REFRESH_TOKEN_TTL_DAYS=30
RECORD_SIGNING_KID=bf-rec-2026-07
ARGON2_MEMORY_KIB=65536                 # 64 MiB — re-benchmark on target host
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=4
STEP_UP_WINDOW_SECONDS=900              # re-auth window before signing (PR-091)

# --------------------------------------------------------- auth policy
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_STEP_UP_PER_MIN=10          # 10/min per user (API_SPECIFICATION.md §9)
RATE_LIMIT_API_PER_MIN=300
SESSION_IDLE_TIMEOUT_MINUTES=60
PASSWORD_MIN_LENGTH=12

# ------------------------------------------------- multi-factor auth (13-MFA)
# BUILD_HANDOFF §5 moved MFA into Release 1 and withdrew SEC RS-3.
#
# ⚠️ MFA_ENABLED MUST STAY false UNTIL THE MFA UI (slice 13-UI) IS DEPLOYED.
# The only production account, samuel@vorkhive.com, is ADMIN — a role in
# MFA_REQUIRED_ROLES. Turning this on before there is a screen that can
# collect a TOTP code locks the sole administrator out of production. With it
# false, /auth/login behaves exactly as it did before slice 13-MFA; the
# /auth/mfa/enrol endpoints still work, so users may enrol ahead of the flip.
MFA_ENABLED=false
# CSV. MAINTAINER is deliberately absent and should stay absent — SEC §14
# RS-3/SO-3: MFA on gloved hands in a cleanroom pushes users back to paper.
MFA_REQUIRED_ROLES=ADMIN,TEAM_LEADER,ENGINEER,DOC_CONTROLLER,AUDITOR
MFA_TOTP_ISSUER=BamForm                 # shown in the authenticator app
MFA_CHALLENGE_TTL_SECONDS=300           # 5 min, the post-password login window
RATE_LIMIT_MFA_VERIFY_PER_MIN=10        # per user (also /auth/mfa/enrol/confirm)
RATE_LIMIT_MFA_RECOVERY_PER_MIN=5       # per user
RATE_LIMIT_MFA_ENROL_PER_MIN=10         # per user (POST /auth/mfa/enrol)
RATE_LIMIT_PASSWORD_CHANGE_PER_MIN=10   # per user (POST /auth/password)

# ------------------------------------------ forced password change (13-MFA §7)
# ⚠️ FORCE_PASSWORD_CHANGE_ENABLED MUST STAY false UNTIL THE PASSWORD-CHANGE
# SCREEN (slice 13-UI) IS DEPLOYED — the same hazard as MFA_ENABLED above.
# With it true, POST /users marks the new account must_change_password, and a
# global deny-by-default guard then returns 403 /errors/password-change-required
# from every endpoint except GET /auth/me, POST /auth/password and
# POST /auth/logout. There is no screen that can collect a new password yet, so
# turning this on before 13-UI hard-locks the first user Samuel creates.
# With it false, POST /users behaves exactly as it did in slice 13a. The
# endpoint, the guard, the column and the audit event all still ship and are
# still exercised — only the FORCING is dormant, and a row that already carries
# the flag is still honoured.
FORCE_PASSWORD_CHANGE_ENABLED=false

# ------------------------------------------------------------ scheduler
# false in local and CI — a test run must never generate jobs (PR-ENV-09)
SCHEDULER_ENABLED=true
# QUOTED deliberately. `auto-deploy-bamform.sh` sources this file with
# `set -a; . .env`, so an unquoted cron expression is glob-expanded by the
# shell and an unquoted display name containing `<` is parsed as a redirect —
# the latter is a hard syntax error that ABORTS the source, silently dropping
# every variable defined below it (which is how DEPLOY_BACKUP_DIR and
# BACKUP_ENCRYPTION_KEY came to be missing from the deploy shell's
# environment). Compose's own .env parser is unaffected either way and strips
# these quotes, so the containers see the same values as before.
SCHEDULER_CRON="0 * * * *"
SCHEDULER_LOCK_TTL_SECONDS=300
AUDIT_CHAIN_VERIFY_CRON="0 2 * * *"
DEFAULT_LEAD_TIME_DAYS=30
DUE_SOON_WARNING_DAYS=7
VERIFICATION_ESCALATION_HOURS=72

# --------------------------------------------------------- notification
# false in local and CI — a test run must never email real staff
NOTIFICATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=bamform@bevorasg.com

# ------------------------------------------------------------ frontend
# VITE_ variables ship in the browser bundle. NEVER put a secret here —
# CI fails the build if one appears (PR-ENV-10).
VITE_API_BASE_URL=/api/v1
VITE_OFFLINE_HISTORY_DAYS=90

# ----------------------------------------------------------- deployment
COMPOSE_PROJECT_NAME=bamform
# RELATIVE deliberately. An absolute `/opt/bamform/docker-compose.yml` makes
# every bare `docker compose` command fail on any checkout that is not at that
# path, and it also OVERRIDES the COMPOSE_FILE that
# scripts/server/auto-deploy-bamform.sh sets for itself (it sources this file
# with `set -a`, after its own assignment). Relative resolves against the
# working directory, which is the repo root on the server and on a developer
# machine alike — the deploy script `cd`s to $REPO before its first compose
# call, so both are correct.
COMPOSE_FILE=docker-compose.yml
DEPLOY_LOG=/var/log/bamform-deploy.log
DEPLOY_BACKUP_DIR=/var/backups/bamform

# -------------------------------------------------------- emergency use
MAINTENANCE_READONLY=false              # RUN §12.3
